{
    "name": "islam016/laravel-safe-checkout",
    "description": "Safe checkout for Laravel with Moyasar and Tap: idempotent payment creation, verified webhooks, amount reconciliation against the gateway, and a status state machine that never pays an order twice or marks a wrong amount as paid.",
    "keywords": ["laravel", "payments", "checkout", "moyasar", "tap", "webhooks", "idempotency", "saudi-arabia", "mada", "sar"],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/Islam016/laravel-safe-checkout",
    "authors": [
        {
            "name": "Islam Gaber",
            "email": "islamgaber873@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/queue": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "IslamGaber\\SafeCheckout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IslamGaber\\SafeCheckout\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "IslamGaber\\SafeCheckout\\SafeCheckoutServiceProvider"
            ],
            "aliases": {
                "Checkout": "IslamGaber\\SafeCheckout\\Facades\\Checkout"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
